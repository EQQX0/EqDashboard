{
  "name": "samsung-server-desktop",
  "productName": "Samsung Server",
  "version": "0.13.4",
  "description": "Windows client for the Samsung home server",
  "main": "main.js",
  "author": "EQQX0",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.eqqx2.samsungserver.desktop",
    "productName": "Samsung Server",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "api.js",
      "pairscan.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Samsung-Server-Setup-${version}.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Samsung Server",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": false,
      "include": "build/installer.nsh"
    }
  }
}